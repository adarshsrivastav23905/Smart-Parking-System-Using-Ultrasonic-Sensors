# ==========================================

# Smart Parking System - Git Ignore

# ==========================================

# VS Code

.vscode/
*.code-workspace

# PlatformIO

.pio/
.piolibdeps/
.platformio/

# Arduino temporary/build files

build/
*.hex
*.elf
*.eep
*.map
*.bin

# Temporary files

*.tmp
*.temp
*.bak
*.swp
*.swo

# Logs

*.log

# Operating System files

.DS_Store
Thumbs.db
desktop.ini

# Python cache (if used for future scripts)

**pycache**/
*.py[cod]

# Jupyter Notebook checkpoints

.ipynb_checkpoints/

# Environment files

.env
.env.*
!.env.example

# IDE temporary files

.idea/
*.iml

# Backup files

*~
#*#

