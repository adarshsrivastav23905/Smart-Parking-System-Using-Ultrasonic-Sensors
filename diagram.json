    ["sensor3:VCC", "uno:5V", "red", []],
    ["sensor3:GND", "uno:GND.1", "black", []],
    ["sensor3:TRIG", "uno:6", "green", []],
    ["sensor3:ECHO", "uno:7", "blue", []],

    ["sensor4:VCC", "uno:5V", "red", []],
    ["sensor4:GND", "uno:GND.1", "black", []],
    ["sensor4:TRIG", "uno:8", "green", []],
